# HadalOS kernel configuration fragment.
#
# Merged over the upstream `make defconfig` baseline by
# kernel-build_merge_configs(). This is deliberately a fragment and not a
# complete .config: a 12,000-line config is not reviewable, and nobody can
# tell from one which settings are deliberate. Everything here is a decision.
#
# The systemd section is not optional garnish. HadalOS's isolation guarantees
# are written as systemd directives in systemd/*.service, and several of them
# fail *silently* on a kernel that lacks the corresponding symbol —
# IPAddressDeny= without CONFIG_CGROUP_BPF does not error, it just does not
# filter. scripts/check-kernel-config.py enforces the link between the units
# and this file; run it after editing either.

# ── Identity ──────────────────────────────────────────────────────────
CONFIG_LOCALVERSION="-hadalos"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_DEFAULT_HOSTNAME="hadalos"

# ── systemd baseline ──────────────────────────────────────────────────
# Per systemd's own README. Missing any of these gives a system that boots
# to a confusing failure rather than an informative one.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_UNIX=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_FHANDLE=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_NET=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_AUTOFS_FS=y
CONFIG_KCMP=y
CONFIG_BLK_DEV_INITRD=y

# ── What the broker's sandboxing actually requires ────────────────────
# Each of these backs a directive in systemd/hadald.service or
# systemd/hadal-brokerd.service. Removing one does not break the boot; it
# quietly removes a security property.

# PrivateNetwork=yes  — the kernel-level guarantee that hadald has no route out
CONFIG_NET_NS=y
# PrivateUsers=yes
CONFIG_USER_NS=y
# PrivateTmp=, ProtectSystem=strict, ProtectHome=
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
# SystemCallFilter=, RestrictNamespaces=, RestrictRealtime=,
# LockPersonality=, RestrictAddressFamilies=
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# IPAddressDeny=any — silently a no-op without these
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
# DeviceAllow= (unified hierarchy implements it via BPF, above)
CONFIG_CGROUP_DEVICE=y
# MemoryMax=, MemoryHigh= — the ceiling that stops inference starving the desktop
CONFIG_MEMCG=y
# CPUWeight=, IOWeight=
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
# Audit trail for a component that can change the system
CONFIG_AUDIT=y

# ── Boot ──────────────────────────────────────────────────────────────
# Limine boots via the Linux protocol; EFI_STUB is what makes the fallback
# path (direct EFI boot of the same image) possible without a second kernel.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_VARS_PSTORE=y
CONFIG_EFIVAR_FS=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y

# The ESP is VFAT. Without the NLS pieces the mount fails at boot with an
# error that reads like unrelated filesystem corruption.
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# ── Live ISO ──────────────────────────────────────────────────────────
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_LOOP=y

# ── Filesystems ───────────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_FS=y
CONFIG_F2FS_FS=y

# ── Graphics ──────────────────────────────────────────────────────────
# Reference hardware: RX 9060 (RDNA4) and Intel Iris Xe. Both fully in-tree,
# which is the whole reason riding mainline is safe here — see
# ARCHITECTURE.md, "Why mainline-tip is safe here specifically".
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
# ROCm, so the deep model can use the GPU rather than the CPU
CONFIG_HSA_AMD=y
CONFIG_HSA_AMD_SVM=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m

# ── Input ─────────────────────────────────────────────────────────────
# libinput, and therefore XLibre and hadalwm, read from evdev. Not a module:
# an input-less X server is a machine you cannot recover from interactively.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=m
CONFIG_HIDRAW=y
CONFIG_USB_HID=y

# ── Hardening ─────────────────────────────────────────────────────────
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"

# ── Misc ──────────────────────────────────────────────────────────────
CONFIG_ZRAM=m
CONFIG_ZSWAP=y
CONFIG_WATCHDOG=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_INTEL_PSTATE=y
