#!/bin/bash
# hadalos-limine-update — regenerate limine.conf from installed HadalOS kernels.
#
# sys-boot/limine ships no installkernel/kernel-install integration the way
# GRUB and systemd-boot do, so HadalOS generates the config itself.
#
# Layout this owns:
#   $BOOT_ROOT/hadalos/<version>/vmlinuz
#   $BOOT_ROOT/hadalos/<version>/initrd      (optional)
#   $BOOT_ROOT/limine.conf                  (generated; do not hand-edit)
#
# Invariant, and the entire reason this script exists: the generated config
# always offers a last-known-good entry when one is recorded and still
# present on disk. HadalOS rides mainline; the fallback is not a nicety.
#
# Safe to run by hand at any time. Idempotent.

set -euo pipefail

BOOT_ROOT="${KERNEL_INSTALL_BOOT_ROOT:-/boot}"
KERNEL_DIR="$BOOT_ROOT/hadalos"
CONF="$BOOT_ROOT/limine.conf"
# Overridable so the pinning logic can be exercised without root. A test that
# needs to write /etc to run is a test nobody runs, which is how the whole
# last-known-good path reached hardware unexercised.
HADALOS_ETC="${HADALOS_ETC:-/etc/hadalos}"
LASTGOOD_FILE="$HADALOS_ETC/lastgood"
CONF_D="$HADALOS_ETC/limine.d"

log() { printf 'hadalos-limine-update: %s\n' "$*" >&2; }
die() { log "error: $*"; exit 1; }

# ── cmdline ─────────────────────────────────────────────────────────────
# systemd's documented search order. /proc/cmdline is a last resort and is
# noisy (it carries whatever the bootloader passed, including BOOT_IMAGE),
# so we strip the entries that are meaningless to re-supply.
read_cmdline() {
    local f
    for f in /etc/kernel/cmdline /usr/lib/kernel/cmdline; do
        if [[ -r $f ]]; then
            tr '\n' ' ' <"$f" | sed 's/  */ /g; s/^ //; s/ $//'
            return
        fi
    done
    log "no /etc/kernel/cmdline; deriving from /proc/cmdline"
    tr ' ' '\n' </proc/cmdline \
        | grep -Ev '^(BOOT_IMAGE|initrd)=' \
        | tr '\n' ' ' | sed 's/  */ /g; s/^ //; s/ $//'
}

# ── discovery ───────────────────────────────────────────────────────────
# Newest first. sort -V handles 7.2.0 vs 7.10.0 correctly; a lexical sort
# does not, and that bug surfaces exactly once, at the worst time.
installed_versions() {
    [[ -d $KERNEL_DIR ]] || return 0
    local d
    for d in "$KERNEL_DIR"/*/; do
        [[ -e ${d}vmlinuz ]] || continue
        basename "$d"
    done | sort -Vr
}

emit_entry() {
    local version="$1" label="$2" cmdline="$3"
    printf '\n/%s\n' "$label"
    printf '    protocol: linux\n'
    printf '    path: boot():/hadalos/%s/vmlinuz\n' "$version"
    [[ -n $cmdline ]] && printf '    cmdline: %s\n' "$cmdline"
    if [[ -e $KERNEL_DIR/$version/initrd ]]; then
        printf '    module_path: boot():/hadalos/%s/initrd\n' "$version"
    fi
}

main() {
    [[ -d $BOOT_ROOT ]] || die "boot root $BOOT_ROOT does not exist"

    local cmdline versions lastgood=""
    cmdline="$(read_cmdline)"

    mapfile -t versions < <(installed_versions)
    (( ${#versions[@]} )) || die "no kernels under $KERNEL_DIR — refusing to write an empty config"

    [[ -r $LASTGOOD_FILE ]] && lastgood="$(tr -d '[:space:]' <"$LASTGOOD_FILE")"
    if [[ -n $lastgood && ! -e $KERNEL_DIR/$lastgood/vmlinuz ]]; then
        log "recorded last-known-good $lastgood is no longer installed; ignoring"
        lastgood=""
    fi

    local tmp
    tmp="$(mktemp "$CONF.XXXXXX")"
    # shellcheck disable=SC2064
    trap "rm -f '$tmp'" EXIT

    {
        printf '# Generated by hadalos-limine-update. Do not edit.\n'
        printf '# Drop-ins: %s/*.conf are appended verbatim.\n' "$CONF_D"
        printf '# Kernel cmdline comes from /etc/kernel/cmdline.\n\n'
        printf 'timeout: 5\n'
        printf 'default_entry: 1\n'

        local v first=1
        for v in "${versions[@]}"; do
            local label="HadalOS $v"
            (( first )) && label="$label (current)"
            # ASCII only: entry titles render in BIOS text mode, where a
            # UTF-8 dash is a gamble for no benefit.
            [[ $v == "$lastgood" ]] && label="$label [last known good]"
            emit_entry "$v" "$label" "$cmdline"
            first=0
        done

        # If last-known-good scrolled off the list above it would still have
        # been emitted, since we iterate every installed version. The pin's
        # real job is upstream of here: keeping that kernel from being
        # garbage-collected in the first place.

        if [[ -d $CONF_D ]]; then
            local f
            for f in "$CONF_D"/*.conf; do
                [[ -e $f ]] || continue
                printf '\n# ── %s ──\n' "$(basename "$f")"
                cat "$f"
            done
        fi
    } >"$tmp"

    chmod 0644 "$tmp"
    mv "$tmp" "$CONF"
    trap - EXIT

    log "wrote $CONF (${#versions[@]} kernel(s)${lastgood:+, last known good: $lastgood})"
}

main "$@"
