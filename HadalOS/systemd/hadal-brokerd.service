[Unit]
Description=Hadal capability broker (org.hadal.Broker1)
Documentation=https://github.com/shmizzledizzle/HadalOS
Requires=hadald.service
After=hadald.service dbus.service
Requires=dbus.service

# Shares hadald's network namespace. See the block above ExecStart= for why
# that is what makes a root broker defensible.
#
# This directive lived in [Service] until 2026-08-24, where systemd does not
# accept it: `Unknown key 'JoinsNamespaceOf' in section [Service], ignoring`,
# logged once per start and never read. The unit therefore did not share
# hadald's namespace at all. `PrivateNetwork=yes` meant the failure was
# invisible — the broker got its *own* empty namespace, so it still had no
# route to the network and still looked correctly confined, while the property
# actually being relied on was absent. A comment describing a guarantee, and a
# directive in the wrong section silently not providing it.
JoinsNamespaceOf=hadald.service

[Service]
Type=dbus
BusName=org.hadal.Broker1
ExecStart=/usr/libexec/hadal-brokerd
Restart=on-failure
RestartSec=2s

# ── Why this runs as root, and why that is not the usual mistake ───────
# The broker executes authorized actions (emerge, systemctl), so it needs
# privilege. What makes that defensible is that it contains no model code
# and never evaluates model output as a command:
#
#   * it shares hadald's network namespace (below), so it cannot reach the
#     network any more than hadald can;
#   * every action is a closed-enum variant with a typed, validated
#     parameter struct — there is no argv path from a generation to exec;
#   * every mutating variant is gated on a polkit auth_admin check against
#     its own action id, resolved per invocation and never retained.
#
# The privilege lives in the component that has no language model in it.
# That separation is the whole design.
#
# JoinsNamespaceOf= is in [Unit] above — it is a unit property, not a service
# one, and systemd ignores it here.
PrivateNetwork=yes
IPAddressDeny=any

ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
NoNewPrivileges=no
SystemCallArchitectures=native

# Audit trail is not optional for a component that can change the system.
LogLevelMax=info
StateDirectory=hadal-broker

[Install]
WantedBy=multi-user.target
