[Unit]
Description=Hadal model host
Documentation=https://github.com/shmizzledizzle/HadalOS
After=network.target
Before=hadal-brokerd.service

# A misconfiguration does not become correct by being retried. Without these the
# unit burns its start limit on a bad model id or an unreadable key, and the
# journal carries the real error once followed by hundreds of identical
# restarts — which is where it goes to hide. Three attempts rides out a
# genuinely transient failure and keeps the cause on screen.
#
# [Unit], not [Service]. These moved sections in systemd 229 and are silently
# ignored in [Service] — the same failure hadal-brokerd's JoinsNamespaceOf= had,
# which is reason enough to say so here rather than rediscover it a third time.
StartLimitBurst=3
StartLimitIntervalSec=60

# Unconfigured is not the same as broken, and must not look like it.
#
# `EnvironmentFile=` without a `-` is a hard failure, and with `Restart=
# on-failure` that becomes a restart loop: on this machine hadald reached
# **264 restarts** against a missing /etc/hadal/hadald.env, hit the start limit,
# and the only thing hadal-brokerd could then report was "Dependency failed".
# `Failed to spawn 'start' task: No such file or directory` repeated 264 times
# is not a message that says "you have not configured this yet".
#
# The condition makes the unconfigured state its own state: systemd skips the
# unit and says so once, naming the thing that is actually missing.
ConditionPathExists=/etc/hadal/hadald.env

[Service]
Type=exec
# hadald has no --config flag. It never did: config.rs parses arguments with a
# closed match whose fallback is `unknown argument: {other}`, so the previous
# ExecStart here — `--serve --config /etc/hadal/hadald.toml` — exited with a
# usage error before opening a socket. The unit was written before the daemon
# and the two had never been started together.
#
# The model id is the one setting that genuinely varies per machine, so it comes
# from an environment file rather than being baked in. The key deliberately does
# not: it stays a file with an owner and a mode, because a process environment is
# readable through /proc/<pid>/environ, is inherited by children, and appears in
# `systemctl show`.
EnvironmentFile=/etc/hadal/hadald.env

# The default upstream, overridable by the environment file above.
#
# `Environment=` is applied before `EnvironmentFile=` regardless of the order
# they appear in, so a HADAL_UPSTREAM in the file wins. It has to exist at all
# because ${HADAL_UPSTREAM} is expanded unconditionally below, and an unset
# variable would pass `--upstream ""` — which is neither local nor a usable URL.
Environment=HADAL_UPSTREAM=https://integrate.api.nvidia.com/v1

# --upstream was missing, and its absence was documented as though it worked.
# hadald takes the upstream as a CLI flag; this unit never passed one, so it
# always used config.rs's DEFAULT_UPSTREAM — the NVIDIA endpoint — and therefore
# always classified Remote and always demanded a key. Meanwhile this package's
# own pkg_postinst instructed the user to write
# `HADAL_UPSTREAM=http://127.0.0.1:8080/v1` into the environment file to select
# the local tier. That variable was set, exported, and read by nothing: the
# local tier could not be reached by following its own instructions.
ExecStart=/usr/bin/hadald --serve --model ${HADAL_MODEL} \
    --upstream ${HADAL_UPSTREAM} \
    --key-file /etc/hadal/upstream.key \
    --egress-log /var/log/hadal/egress.log
Restart=on-failure
RestartSec=2s

User=hadal
Group=hadal
StateDirectory=hadal
ConfigurationDirectory=hadal
# ProtectSystem=strict below makes /var read-only, so --egress-log would fail
# to open a path that plainly exists. LogsDirectory creates /var/log/hadal with
# the right owner AND punches it through the read-only mount; ReadWritePaths on
# its own would do the second without the first.
#
# This is the boot layer's finding again — "ReadWritePaths= must name the same
# boot root the service actually writes to, or ProtectSystem=strict silently
# blocks the write" — and the egress log is the worst possible place to
# rediscover it, because a privacy record that silently fails to open is
# indistinguishable from one with nothing to report.
LogsDirectory=hadal
# Models are large and immutable once pulled.
Environment=HADAL_MODELS=/var/lib/hadal/models

# ── Resource ceiling ───────────────────────────────────────────────────
# The assistant is a feature of the desktop, not a claimant against it. A
# model host that can OOM your session is a model host that will, on the day
# you most need the session. These are ceilings, not reservations.
MemoryMax=60%
MemoryHigh=45%
CPUWeight=20
IOWeight=20
# Never let inference win a scheduling fight against interactive work.
Nice=10
OOMPolicy=stop
OOMScoreAdjust=500

# ── Isolation ──────────────────────────────────────────────────────────
# hadald holds the model and nothing else. It has no privilege, no route to
# the filesystem, and — critically — no network. HadalOS's claim that the
# assistant is local is enforced by the kernel here, not by a promise in a
# README.
#
# hadal-brokerd sets JoinsNamespaceOf=hadald.service, so the two share this
# private namespace and reach each other over loopback while remaining
# unable to reach anything else.
#
# Running a deep model on another machine (Hadal's deepHost) is incompatible
# with this as written. The intended path is NOT to drop PrivateNetwork, but
# to add a systemd-socket-proxyd unit in the host namespace pinned to exactly
# one upstream address — so egress stays limited to one host by unit
# configuration rather than by trusting the daemon. Until that exists, a
# LAN deep host requires a documented, deliberate drop-in.
PrivateNetwork=yes
IPAddressDeny=any

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# No GPU access. Removed 2026-08-24, and worth recording why rather than
# leaving a shorter file behind.
#
# This unit used to carry `DeviceAllow=/dev/kfd rw`, `DeviceAllow=char-drm rw`
# and `SupplementaryGroups=video render`, described as "an allowlist of two
# nodes rather than a blanket unmask". Three things were wrong with that:
#
#  - `/dev/kfd` is the ROCm compute device. docs/compute.md §3.1 rejected ROCm
#    outright — AMD-only, forfeits the Iris Xe half of the reference hardware —
#    so this granted access for a stack the project decided not to use, and one
#    that does not exist on the reference laptop at all.
#  - `char-drm` is not a node. It is the whole DRM char-device major, so that
#    line granted *every* DRM device, `card0` included — the display and
#    mode-setting path that cusk owns. The comment described an allowlist and
#    the directive wrote a blanket unmask.
#  - hadald no longer holds a model. The runtime is hadal-model.service, which
#    takes exactly `/dev/dri/renderD128` and gets `render` from its own
#    SupplementaryGroups — the arrangement acct-user/hadal's ebuild already
#    described as the intent: device access granted by the unit that needs it,
#    not baked into the account.
#
# The result is the split worth having: the process holding the API key has no
# device access, and the process with the GPU has no credential.

[Install]
WantedBy=multi-user.target
