[Unit]
Description=Record the running kernel as last known good
Documentation=man:trench-limine-update(8)
After=multi-user.target
# Only meaningful once the system has settled far enough that "it booted"
# is a claim worth making.
ConditionPathExists=/boot/trench

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 60
ExecStart=/usr/bin/trench-mark-boot-good
RemainAfterExit=no

# Touches exactly one file plus the generated bootloader config.
ProtectSystem=strict
ReadWritePaths=/etc/trench /boot
ProtectHome=yes
PrivateNetwork=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
