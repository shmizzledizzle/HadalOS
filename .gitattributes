# Authoring happens on Windows; every one of these files is executed on Linux.
# A CRLF shebang fails as "bad interpreter: /bin/bash^M", which costs an hour
# the first time you meet it. Pin LF and never meet it.

* text=auto eol=lf

*.sh        text eol=lf
*.bash      text eol=lf
*.ebuild    text eol=lf
*.install   text eol=lf
*.service   text eol=lf
*.socket    text eol=lf
*.target    text eol=lf
*.mount     text eol=lf
*.rules     text eol=lf
*.policy    text eol=lf
*.conf      text eol=lf
*.spec      text eol=lf
*.rs        text eol=lf
*.toml      text eol=lf
*.py        text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.cs        text eol=lf
*.axaml     text eol=lf

# Scripts installed without an extension.
overlay/**/files/hadalos-*        text eol=lf
scripts/*                        text eol=lf

# Windows-side helpers stay CRLF.
*.ps1       text eol=crlf
*.cmd       text eol=crlf

*.png       binary
*.jpg       binary
*.iso       binary
*.img       binary
*.tar.xz    binary
