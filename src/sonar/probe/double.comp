#version 450

// Trivial, but it has to be a real dispatch: enumerating a compute queue
// proves the ICD loaded, not that the GPU ran anything.
layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Data {
    uint v[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < v.length()) {
        v[i] = v[i] * 2u + 1u;
    }
}
