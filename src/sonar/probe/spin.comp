#version 450

// A dispatch whose duration is controlled by `iters`, so the same shader can
// stand in for a short frame-sized job and a long compute kernel. The arithmetic
// is a throwaway LCG chosen because it cannot be optimised away and touches no
// memory beyond one store, keeping the variable under test *occupancy time*
// rather than bandwidth.
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Data {
    uint v[];
};

layout(push_constant) uniform P {
    uint n;
    uint iters;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint acc = i + 1u;
    for (uint k = 0u; k < p.iters; k++) {
        acc = acc * 1664525u + 1013904223u;
    }
    if (i < p.n) {
        v[i] = acc;
    }
}
