# HadalOS/ was ignored here on the premise that it was a vendored copy of a
# repo that "has its own history". It has no .git, this repo has no remote,
# and there is no second copy on disk — so the premise was false and the
# desktop broker, the CLI, the ebuilds installed on this machine, the D-Bus
# and polkit policy, the units and the catalyst specs were all unversioned.
# A `git clean -xfd` would have deleted them. It is tracked now.

# Rust
target/
**/*.rs.bk

# AOSP — never, under any circumstances, in git
/out/
/aosp/
/device/*/vendor/
*.img
*.zip

# Editors
.vscode/
.idea/
*.swp

# Claude Code local session state
/.claude/

# hadald build output
/src/hadald/target/

# Cusk build output
/src/cusk/target/
/src/cusk-settings/target/
/src/cusk-launcher/target/
/src/cusk-dock/target/
/src/cusk-keys/target/
